# UberBasi Backend Environment Configuration

# Database Connection (SQLite for local/EC2 volume or PostgreSQL RDS)
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db

# JWT Secret Key
SECRET_KEY=super-secret-key-change-in-production-2026

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://YOUR_AWS_EC2_PUBLIC_IP:3000

# Safaricom Daraja STK Push Credentials
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_PASSKEY=your_daraja_passkey
MPESA_SHORTCODE=174379
